## Public Portfolio
## Next.js app env vars

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional compatibility aliases (if reused utilities expect these names)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Server-only key for public chat transcript persistence.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional signing secret for opaque portfolio chat conversation tokens.
# Defaults to SUPABASE_SERVICE_ROLE_KEY if omitted.
PORTFOLIO_CHAT_TOKEN_SECRET=your_long_random_secret_here
