## Public Portfolio
## Next.js app env vars

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional compatibility aliases (if reused utilities expect these names)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Server-only Supabase key for public chat transcript persistence
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: distinct HMAC secret for public chat conversation tokens.
# Defaults to SUPABASE_SERVICE_ROLE_KEY when omitted.
PORTFOLIO_CHAT_TOKEN_SECRET=replace_with_a_long_random_secret
