## Public Portfolio
## Next.js app env vars

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: defaults to SUPABASE_SERVICE_ROLE_KEY when unset
PORTFOLIO_CHAT_TOKEN_SECRET=your_portfolio_chat_token_secret_here

# Optional compatibility aliases (if reused utilities expect these names)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
